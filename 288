prev = None          
current_len = 1      
max_len = 1          

while True:
    n = int(input())     
    if n == 0:
        break            

    if prev is None:
        prev = n         
        continue

    if n == prev:
        current_len += 1     
    else:
        if current_len > max_len:
            max_len = current_len
        current_len = 1      
        prev = n

    prev = n

if current_len > max_len:
    max_len = current_len

print(max_len)
